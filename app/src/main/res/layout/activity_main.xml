<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/main_bg_sunny_bottom"
    android:clipChildren="false"
    android:clipToPadding="false">

    <FrameLayout
        android:id="@+id/main_content_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false">

        <com.dengyy.weatherapp.ui.WeatherBackgroundView
            android:id="@+id/view_weather_background"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical">

            <View
                android:id="@+id/status_bar_spacer"
                android:layout_width="match_parent"
                android:layout_height="0dp" />

        <LinearLayout
            android:id="@+id/top_bar_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="20dp"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingTop="0dp"
            android:paddingEnd="16dp"
            android:paddingBottom="0dp">

            <ImageButton
                android:id="@+id/button_open_drawer"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/main_drawer_desc"
                android:padding="10dp"
                android:src="@drawable/ic_menu_24"
                android:tint="@color/main_on_surface_strong" />
        </LinearLayout>

            <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
                android:id="@+id/swipe_refresh"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:overScrollMode="never">

            <androidx.core.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:fillViewport="true"
                android:overScrollMode="never">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="16dp"
                                android:paddingBottom="112dp">

                    <LinearLayout
                        android:id="@+id/card_weather_hero"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:paddingTop="10dp"
                        android:paddingBottom="6dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:shadowColor="@color/main_text_glow_soft"
                            android:shadowDx="0"
                            android:shadowDy="0"
                            android:shadowRadius="10"
                            android:text="@string/main_city_overview"
                            android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                            android:textColor="@color/main_on_surface_soft" />

                        <TextView
                            android:id="@+id/text_current_city"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:shadowColor="@color/main_text_glow_strong"
                            android:shadowDx="0"
                            android:shadowDy="0"
                            android:shadowRadius="14"
                            android:textAppearance="@style/TextAppearance.Material3.HeadlineMedium"
                            android:textColor="@color/main_on_surface_strong"
                            tools:text="Beijing" />

                        <TextView
                            android:id="@+id/text_temperature"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:fontFamily="sans-serif-light"
                            android:shadowColor="@color/main_text_glow_strong"
                            android:shadowDx="0"
                            android:shadowDy="0"
                            android:shadowRadius="18"
                            android:textAppearance="@style/TextAppearance.Material3.DisplayLarge"
                            android:textColor="@color/main_on_surface_strong"
                            tools:text="26°" />

                        <TextView
                            android:id="@+id/text_weather_placeholder"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:shadowColor="@color/main_text_glow_strong"
                            android:shadowDx="0"
                            android:shadowDy="0"
                            android:shadowRadius="12"
                            android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
                            android:textColor="@color/main_on_surface_strong"
                            tools:text="Sunny" />

                        <TextView
                            android:id="@+id/text_high_low"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:shadowColor="@color/main_text_glow_soft"
                            android:shadowDx="0"
                            android:shadowDy="0"
                            android:shadowRadius="10"
                            android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                            android:textColor="@color/main_on_surface_soft"
                            tools:text="High 28° / Low 20°" />

                        <TextView
                            android:id="@+id/text_report_time"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:shadowColor="@color/main_text_glow_soft"
                            android:shadowDx="0"
                            android:shadowDy="0"
                            android:shadowRadius="8"
                            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                            android:textColor="@color/main_on_surface_soft"
                            tools:text="Updated 10:30" />
                    </LinearLayout>

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        app:cardBackgroundColor="@color/main_card_surface"
                        app:cardCornerRadius="24dp"
                        app:cardElevation="2dp"
                        app:cardUseCompatPadding="true"
                        app:strokeColor="@color/main_card_stroke"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@color/main_card_surface"
                            android:orientation="vertical"
                            android:padding="20dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/main_weather_metrics"
                                android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                                android:textColor="@color/main_on_surface_strong" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="16dp"
                                android:orientation="horizontal">

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/main_metric_humidity_label"
                                        android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                                        android:textColor="@color/main_on_surface_soft" />

                                    <TextView
                                        android:id="@+id/text_humidity"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="8dp"
                                        android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
                                        android:textColor="@color/main_on_surface_strong"
                                        tools:text="湿度 58%" />
                                </LinearLayout>

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/main_metric_wind_direction_label"
                                        android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                                        android:textColor="@color/main_on_surface_soft" />

                                    <TextView
                                        android:id="@+id/text_wind_direction"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="8dp"
                                        android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
                                        android:textColor="@color/main_on_surface_strong"
                                        tools:text="东南风" />
                                </LinearLayout>

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/main_metric_wind_power_label"
                                        android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                                        android:textColor="@color/main_on_surface_soft" />

                                    <TextView
                                        android:id="@+id/text_wind_power"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="8dp"
                                        android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
                                        android:textColor="@color/main_on_surface_strong"
                                        tools:text="3级" />
                                </LinearLayout>
                            </LinearLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        app:cardBackgroundColor="@color/main_card_surface_strong"
                        app:cardCornerRadius="24dp"
                        app:cardElevation="2dp"
                        app:cardUseCompatPadding="true"
                        app:strokeColor="@color/main_card_stroke"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@color/main_card_surface_strong"
                            android:orientation="vertical"
                            android:padding="20dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/main_forecast_title_3d"
                                android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                                android:textColor="@color/main_on_surface_strong" />

                            <FrameLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="16dp">

                                <androidx.recyclerview.widget.RecyclerView
                                    android:id="@+id/recycler_forecast"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:clipToPadding="false"
                                    android:nestedScrollingEnabled="false"
                                    android:overScrollMode="never"
                                    android:paddingStart="2dp"
                                    android:paddingEnd="2dp"
                                    tools:itemCount="4"
                                    tools:listitem="@layout/item_forecast_card" />

                                <View
                                    android:layout_width="20dp"
                                    android:layout_height="match_parent"
                                    android:layout_gravity="start"
                                    android:background="@drawable/bg_forecast_edge_fade_start" />

                                <View
                                    android:layout_width="20dp"
                                    android:layout_height="match_parent"
                                    android:layout_gravity="end"
                                    android:background="@drawable/bg_forecast_edge_fade_end" />
                            </FrameLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/button_details"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="4dp"
                        android:text="@string/main_view_details_cta"
                        android:textColor="@color/main_on_surface_strong"
                        app:backgroundTint="@color/main_badge_bg" />
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>
            </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
        </LinearLayout>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/drawer_container"
        android:layout_width="320dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/main_drawer_surface">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="32dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/main_sidebar_title"
                    android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
                    android:textColor="@color/main_on_surface_strong" />

                <ImageButton
                    android:id="@+id/button_settings"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/action_open_settings"
                    android:padding="10dp"
                    android:src="@drawable/ic_settings_24"
                    android:tint="@color/main_on_surface_strong" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/main_drawer_profile_card_surface"
                app:cardCornerRadius="24dp"
                app:cardElevation="1dp"
                app:cardUseCompatPadding="true"
                app:strokeColor="@color/main_card_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/main_drawer_profile_card_surface"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/text_drawer_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
                        android:textColor="@color/main_on_surface_strong"
                        tools:text="欢迎回来" />

                    <TextView
                        android:id="@+id/text_drawer_username"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textAppearance="@style/TextAppearance.Material3.HeadlineSmall"
                        android:textColor="@color/main_on_surface_strong"
                        tools:text="Ayaka" />

                    <TextView
                        android:id="@+id/text_drawer_city"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                        android:textColor="@color/main_on_surface_soft"
                        tools:text="当前城市 / 西安" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/text_saved_city_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                android:textColor="@color/main_on_surface_soft"
                tools:text="3 saved cities" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_saved_cities"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="12dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                android:paddingTop="2dp"
                android:paddingBottom="96dp"
                tools:itemCount="4"
                tools:listitem="@layout/item_saved_city" />

            <TextView
                android:id="@+id/text_empty_saved_cities"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/empty_saved_cities"
                android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                android:textColor="@color/main_on_surface_soft"
                android:visibility="gone" />
        </LinearLayout>

        <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
            android:id="@+id/button_add_city"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="24dp"
            android:text="@string/action_add_city"
            android:textColor="@color/main_on_accent"
            app:backgroundTint="@color/main_accent"
            app:iconTint="@color/main_on_accent" />
    </FrameLayout>

</androidx.drawerlayout.widget.DrawerLayout>
