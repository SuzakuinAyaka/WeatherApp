<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <corners android:radius="16dp" />
            <solid android:color="@color/login_input_surface" />
            <stroke
                android:width="1.5dp"
                android:color="@color/login_input_stroke_focused" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="16dp" />
            <solid android:color="@color/login_input_surface" />
            <stroke
                android:width="1dp"
                android:color="@color/login_input_stroke" />
        </shape>
    </item>
</selector>
