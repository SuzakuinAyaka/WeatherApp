<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#F4FBFF"
                android:startColor="#8FCDF8" />
        </shape>
    </item>
    <item
        android:gravity="top|end"
        android:height="360dp"
        android:width="360dp"
        android:top="-36dp"
        android:right="-48dp">
        <shape android:shape="oval">
            <gradient
                android:gradientRadius="180dp"
                android:centerColor="#CCFFF4B8"
                android:endColor="#00FFF4B8"
                android:startColor="#FFFDE28A"
                android:type="radial" />
        </shape>
    </item>
    <item
        android:gravity="top|start"
        android:height="280dp"
        android:width="280dp"
        android:top="90dp"
        android:left="-88dp">
        <shape android:shape="oval">
            <gradient
                android:gradientRadius="160dp"
                android:centerColor="#55FFFFFF"
                android:endColor="#00FFFFFF"
                android:startColor="#D9FFFFFF"
                android:type="radial" />
        </shape>
    </item>
    <item
        android:gravity="bottom|end"
        android:height="260dp"
        android:width="260dp"
        android:bottom="-58dp"
        android:right="-42dp">
        <shape android:shape="oval">
            <gradient
                android:gradientRadius="150dp"
                android:centerColor="#66A8E7FF"
                android:endColor="#00A8E7FF"
                android:startColor="#88C6F1FF"
                android:type="radial" />
        </shape>
    </item>
</layer-list>
